:8080 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy http://server:3000
	}

	handle /images/* {
		reverse_proxy http://server:3000
	}

	# iOS OTA live-update manifests and bundles are served by the server.
	# Without this, /ota/* falls through to the SPA's index.html (200
	# text/html) and the client logs live_update.manifest_invalid.
	handle /ota/* {
		reverse_proxy http://server:3000
	}

	# no-cache makes clients revalidate (cheap 304 via ETag) instead of
	# heuristically caching responses without Cache-Control. iOS's URLSession
	# did exactly that with the SPA fallback once served for /ota/*, replaying
	# it from disk across app launches without contacting the server.
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{
  "name": "go-gather",
  "version": "0.29.4",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint .",
    "prepare": "husky",
    "deps:angular:update": "ng update @angular/core @angular/cli @angular/cdk",
    "deps:angular:ecosystem": "ng update angular-eslint",
    "generate:ios-info-plists": "node scripts/generate-ios-info-plists.mjs",
    "sync:ios:version": "node scripts/sync-ios-version.mjs",
    "prebuild:ios": "node scripts/sync-ios-version.mjs --marketing-only && node scripts/generate-ios-info-plists.mjs && node scripts/bootstrap-ios-firebase-plist.mjs",
    "prebuild:ios:local": "node scripts/write-environment-ios.mjs local && npm run prebuild:ios",
    "prebuild:ios:prod": "node scripts/write-environment-ios.mjs prod && npm run prebuild:ios",
    "build:ios:local": "ng build --configuration ios-local",
    "build:ios:prod": "ng build --configuration ios-prod",
    "sync:ios:local": "npm run build:ios:local && npx cap sync ios",
    "sync:ios:prod": "npm run build:ios:prod && npx cap sync ios",
    "prebuild:ios:prod:ota": "node scripts/write-environment-ios.mjs prod",
    "build:ios:prod:ota": "npm run prebuild:ios:prod:ota && ng build --configuration ios-prod --output-path www/ios-ota"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@capawesome/capacitor-live-update": "^8.7.1",
    "@go-gather/shared": "*",
    "@ionic/angular": "^9.0.10",
    "dayjs": "1.11.23",
    "dexie": "^4.4.7",
    "firebase": "^12.19.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@capacitor/cli": "^8.5.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ionic/angular-toolkit": "^13.0.0",
    "@playwright/test": "^1.64.1",
    "@thetigeregg/commitlint-config": "^2.0.3",
    "@thetigeregg/dev-cli": "^5.0.2",
    "@thetigeregg/lint-staged-config": "^2.0.0",
    "@thetigeregg/ncu-config": "^3.1.0",
    "@thetigeregg/prettier-config": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "23.1.1",
    "plist": "^5.0.0",
    "prettier": "3.9.10",
    "sql.js": "^1.15.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  },
  "description": "An Ionic project"
}
